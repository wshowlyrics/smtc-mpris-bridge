[Unit]
Description=Guest SMTC sessions as MPRIS players (smtc-mpris-bridge host)
Documentation=https://github.com/wshowlyrics/smtc-mpris-bridge

[Service]
# Binds with IP_FREEBIND, so it starts fine before libvirt brings up virbr0.
ExecStart=%h/.local/bin/smtc-mpris-bridge-host --listen 192.168.122.1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
